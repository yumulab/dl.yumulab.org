---
import type { Paper } from '../lib/papers';
import { paperType, typeInfo, paperDate, formatDate, thumbnail } from '../lib/papers';
import { withBase } from '../lib/urls';
import { paperPath } from '../lib/paper-urls';
import AwardBadges from './AwardBadges.astro';
interface Props { paper: Paper; index: number; }
const { paper, index } = Astro.props;
const category = typeInfo(paperType(paper));
const venue = paper.publication?.bookTitleAbbr?.trim() || paper.publication?.bookTitle?.trim();
---
<article class="paper-card" data-paper-id={paper.core.id} style={`--badge-color: ${category.color}`}>
  <a href={withBase(paperPath(paper))} class="paper-card-link">
    <div class="paper-image">
      <img src={thumbnail(paper)} alt="" width="560" height="294" loading={index < 3 ? 'eager' : 'lazy'} decoding="async" />
    </div>
    <div class="paper-content">
      <div class="paper-meta">
        <time datetime={paperDate(paper)}>{formatDate(paperDate(paper))}</time>
        <span class="type-badge">{category.label}</span>
        {venue && <span class="venue-badge">{venue}</span>}
        <AwardBadges awards={paper.awards} />
      </div>
      <h3 class="paper-title">{paper.core.title}</h3>
      <div class="paper-byline">
        <p class="paper-authors"><span>{paper.core.authors?.join(', ')}</span></p>
        {venue && <p class="paper-venue"><span class="venue-badge">{venue}</span></p>}
        <AwardBadges awards={paper.awards} />
      </div>
    </div>
  </a>
</article>
