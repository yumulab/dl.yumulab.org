---
import Icon from './Icon.astro';
import type { PaperAward } from '../lib/papers';
import { safeUrl } from '../lib/papers';

interface Props { awards?: PaperAward[]; linked?: boolean; }
const { awards = [], linked = false } = Astro.props;
---
{awards.length > 0 && <ul class="award-badges" aria-label="受賞">
  {awards.map((award) => {
    const href = linked ? safeUrl(award.sourceUrl) : undefined;
    const Tag = href ? 'a' : 'span';
    return <li><Tag class="award-badge" href={href}>
      <Icon name="trophy" size={14} /><span><span class="sr-only">受賞： </span>{award.name}</span>
    </Tag></li>;
  })}
</ul>}
