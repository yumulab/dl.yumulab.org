---
import { papers } from '../../lib/papers';
import { paperSlug, paperPath } from '../../lib/paper-urls';
import { withBase } from '../../lib/urls';

export function getStaticPaths() {
  return papers.flatMap((paper) => [
    { params: { slug: paper.core.id }, props: { destination: paperPath(paper) } },
    { params: { slug: paperSlug(paper) }, props: { destination: paperPath(paper) } },
  ]);
}

interface Props { destination: string; }
return Astro.redirect(withBase(Astro.props.destination), 301);
---
