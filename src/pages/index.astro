---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import PaperCard from '../components/PaperCard.astro';
import { papers, paperFiscalYear, paperTypes, filterPapers, groupPapersByFiscalYear, fiscalYearGroupLabel } from '../lib/papers';
import { withBase } from '../lib/urls';
const sorted = filterPapers(papers, { q: '', year: '', type: '', sort: 'newest', view: 'grid' });
const years = [...new Set(papers.map(paperFiscalYear).filter(Boolean))].sort().reverse();
---
<Layout>
  <div class="view-bar">
    <div class="view-bar-inner">
      <div class="view-options" role="group" aria-label="表示形式">
        <button type="button" data-view="grid" aria-controls="papers" aria-pressed="true"><Icon name="grid" size={16} />グリッド表示</button>
        <button type="button" data-view="list" aria-controls="papers" aria-pressed="false"><Icon name="list" size={16} />リスト表示</button>
        <button type="button" data-view="text" aria-controls="papers" aria-pressed="false"><Icon name="text" size={16} />テキスト表示</button>
      </div>
      <p id="result-count" role="status" aria-live="polite">全 {papers.length} 件</p>
    </div>
  </div>
  <div class="catalog-layout">
    <section class="filters" aria-label="論文の検索と絞り込み">
      <form id="search-form" role="search" action={withBase('/')} method="get">
        <div class="filter-field">
          <label for="query">検索</label>
          <div class="search-input"><Icon name="search" size={17} /><input id="query" name="q" type="search" placeholder="タイトル・著者・キーワード" autocomplete="off" /><button type="submit" aria-label="検索する"><Icon name="arrow" size={17} /></button></div>
        </div>
        <div class="filter-field"><label for="year">年度</label><div class="select-wrap"><select id="year" name="year"><option value="">すべて</option>{years.map((year) => <option value={year}>{year}年度</option>)}</select><Icon name="chevron" size={15} /></div></div>
        <div class="filter-field"><label for="type">種類</label><div class="select-wrap"><select id="type" name="type"><option value="">すべて</option>{Object.entries(paperTypes).map(([key, value]) => <option value={key}>{value.label}</option>)}<option value="other">その他</option></select><Icon name="chevron" size={15} /></div></div>
        <div class="filter-field"><label for="sort">並び順</label><div class="select-wrap"><select id="sort" name="sort"><option value="newest">新しい順</option><option value="oldest">古い順</option></select><Icon name="chevron" size={15} /></div></div>
        <button type="button" id="reset-filters" class="reset-button"><Icon name="close" size={14} />条件をクリア</button>
      </form>
    </section>
    <main id="main" class="catalog-main">
      <h1 class="sr-only">論文一覧</h1>
      <noscript><p class="notice">検索・表示切り替えを利用するにはJavaScriptを有効にしてください。すべての論文は以下から閲覧できます。</p></noscript>
      <div id="active-filters" class="active-filters" aria-label="現在の検索条件" hidden></div>
      <div id="papers" class="papers-grid" data-view="grid">
        {groupPapersByFiscalYear(sorted).map(({ year, papers: yearPapers }) => <Fragment>
          <h2 class="paper-year-heading">{fiscalYearGroupLabel(year)}</h2>
          {yearPapers.map((paper) => <PaperCard paper={paper} index={sorted.indexOf(paper)} />)}
        </Fragment>)}
      </div>
      <div id="empty-state" class="empty-state" hidden><Icon name="search" size={36} /><h2>該当する論文が見つかりませんでした</h2><p>キーワードや絞り込み条件を変えてお試しください。</p><button type="button" id="empty-reset" class="outline-button">すべての論文を表示</button></div>
      <p class="catalog-end" id="catalog-end">全 {papers.length} 件の研究成果を表示しています</p>
    </main>
  </div>
  <script>
    import '../scripts/catalog';
  </script>
</Layout>
